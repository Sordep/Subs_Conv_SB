{
  "log": {
    "disabled": true,
    "level": "debug",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "direct",
      "default_mode": "Enhanced",
      "access_control_allow_private_network": true
    },
  "cache_file": {
    "enabled": true,
    "store_rdrc": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "proxyDns",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "localDns",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "type": "local",
        "tag": "systemDns"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "server": "localDns"
      },
      {
        "clash_mode": "global",
        "server": "proxyDns"
      },
      {
        "domain": [
          "mirror.ghproxy.com",
          "ghproxy.com",
          "cdn.jsdelivr.net",
          "testingcf.jsdelivr.net"
        ],
        "server": "localDns"
      },
      {
        "rule_set": "geosite-cn",
        "server": "localDns"
      },
      {
        "domain_suffix": [
          ".zf-world.com",
          ".allawntech.com",
          ".zf.com"
        ],
        "server": "systemDns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite-gfw",
            "invert": true
          },
          {
            "rule_set": "geoip-cn"
          }
        ],
        "server": "proxyDns",
        "client_subnet": "114.114.114.114/24"
      }
    ],
    "independent_cache": true,
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.0/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": true,
      "stack": "system"
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 6118
    }
  ],
