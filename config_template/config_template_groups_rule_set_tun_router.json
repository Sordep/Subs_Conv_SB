      "outbounds":[
        "{all}"
      ],
      "filter":[
        {"action":"exclude","keywords":["网站|剩余|流量|过期|时间|期|地址|勿连接|去除"]}
      ],
      "url": "http://www.gstatic.com/generate_204",
